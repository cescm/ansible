[Unit]
Description=Rclone mount Movistar (crypt)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/root/.config/rclone/rclone.conf

[Service]
Type=notify
User=root
Group=root
StartLimitIntervalSec=0

ExecStart=/usr/local/bin/rclone-movistar mount movistar_enc: /mnt/movistar_enc \
  --config /root/.config/rclone/rclone.conf \
  --allow-other \
  --allow-non-empty \
  --uid 1000 \
  --gid 1000 \
  --umask 002 \
  --vfs-cache-mode full \
  --vfs-cache-max-size 100G \
  --vfs-write-back 5s \
  --cache-dir=/mnt/movistar_cache \
  --vfs-read-chunk-size 4M \
  --vfs-read-chunk-size-limit 64M \
  --buffer-size 16M \
  --vfs-read-wait 20ms \
  --dir-cache-time 5m \
  --attr-timeout 10m \
  --timeout 5m \
  --contimeout 30s \
  --retries 10 \
  --low-level-retries 30 \
  --vfs-cache-max-age 72h \
  --async-read \
  --log-level INFO \
  --log-file /var/log/rclone-crypt.log

ExecStop=/bin/fusermount3 -uz /mnt/movistar_enc
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target
