# rclone-rc-exporter.service
# ------------------------------------------------------------------
# Runs once (Type=oneshot) /usr/local/bin/rclone-rc-to-prometheus.sh.
# Not launched directly: the timer rclone-rc-exporter.timer starts it
# every 30s. The script queries the rclone mount RC API
# (http://127.0.0.1:5572, enabled with --rc --rc-addr in
# rclone-movistar-webdav.service) and writes /mnt/docker/monitoring/textfile/rclone.prom
# in Prometheus textfile format.
# ------------------------------------------------------------------
[Unit]
Description=Export rclone mount RC stats to node-exporter textfile
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rclone-rc-to-prometheus.sh