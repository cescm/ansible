# rclone-rc-exporter.timer
# ------------------------------------------------------------------
# Triggers rclone-rc-exporter.service (oneshot) every 30s. Monitoring
# chain: mount rclone RC API -> textfile script ->
# node-exporter (--collector.textfile.directory) -> Prometheus ->
# Grafana dashboard 'Rclone Mounts' (uid rclone-mounts).
# ------------------------------------------------------------------
[Unit]
Description=Run rclone RC exporter every 30 seconds

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target