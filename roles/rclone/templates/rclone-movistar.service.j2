[Unit]
Description=Rclone mount Movistar (raw)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=/root/.config/rclone/rclone.conf

[Service]
Type=notify
User=root
Group=root
TimeoutStartSec=infinity

ExecStartPre=/bin/bash -c 'for i in $$(seq 1 90); do getent hosts micloud.movistar.es >/dev/null 2>&1 && exit 0; sleep 10; done; exit 1'
ExecStart=/usr/local/bin/rclone-movistar mount movistar: /mnt/movistar \
  --config /root/.config/rclone/rclone.conf \
  --allow-other \
  --allow-non-empty \
  --uid 1000 \
  --gid 1000 \
  --umask 002 \
  --vfs-cache-mode full \
  --vfs-cache-max-size 100G \
  --vfs-write-back 5s \
  --cache-dir=/mnt/movistar_raw_cache \
  --vfs-read-chunk-size 4M \
  --vfs-read-chunk-size-limit 64M \
  --buffer-size 16M \
  --vfs-read-wait 20ms \
  --dir-cache-time 5m \
  --attr-timeout 10m \
  --timeout 5m \
  --contimeout 30s \
  --retries 10 \
  --low-level-retries 30 \
  --vfs-cache-max-age 72h \
  --async-read \
  --log-level INFO \
  --log-file /var/log/rclone.log

ExecStop=/bin/fusermount3 -uz /mnt/movistar
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target
