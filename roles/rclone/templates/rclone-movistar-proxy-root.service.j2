# ============================================================================
# rclone-movistar-proxy-root.service
# ============================================================================
# Mounts the RAW proxy root (http://localhost:5052/) on
# /mnt/movistar_proxy_root WITHOUT crypt: shows the folders as stored on
# Movistar (AC/, AMS2/, encrypted/, tfzkeOp0WWA1IaWYr1kPfg==/...).
#
# Chain: movistar_proxy (raw webdav) -> uniextra container localhost:5052 -> Movistar micloud.
# The crypt mount (movistar_encrypted) lives on /mnt/movistar_proxy; this is
# a second mount exposing the whole root for inspection/troubleshooting.
#
# Logs: /var/log/rclone-movistar-proxy-root.log (DEBUG level).
# ============================================================================
[Unit]
Description=Rclone mount Movistar Proxy WebDAV raw root (proxy /)
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/root/.config/rclone/rclone.conf
StartLimitIntervalSec=0

[Service]
Type=notify
User=root
Group=root

ExecStartPre=/usr/local/bin/rclone-cache-clean-proxy-root.sh
ExecStart=/usr/bin/rclone mount movistar_proxy: /mnt/movistar_proxy_root \
  --config /root/.config/rclone/rclone.conf \
  --allow-other \
  --allow-non-empty \
  --uid 1000 \
  --gid 1000 \
  --umask 002 \
  --vfs-cache-mode full \
  --vfs-cache-max-size 100G \
  --vfs-write-back 5s \
  --cache-dir=/mnt/movistar_proxy_root_cache \
  --vfs-read-chunk-size 134217728 \
  --vfs-read-chunk-size-limit 134217728 \
  --buffer-size 16M \
  --vfs-read-wait 20ms \
  --dir-cache-time 5m \
  --attr-timeout 10m \
  --timeout 5m \
  --contimeout 30s \
  --retries 10 \
  --low-level-retries 30 \
  --vfs-cache-max-age 72h \
  --async-read \
  --rc \
  --rc-addr 127.0.0.1:5575 \
  --log-level DEBUG \
  --log-file /var/log/rclone-movistar-proxy-root.log

ExecStartPost=/bin/bash -c 'for i in $$(seq 1 10); do mountpoint -q /mnt/movistar_proxy_root && mount --make-shared /mnt/movistar_proxy_root && break; sleep 1; done'
ExecStop=/bin/fusermount3 -uz /mnt/movistar_proxy_root
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target