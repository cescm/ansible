# ============================================================================
# rclone-movistar-proxy.service
# ============================================================================
# Mounts Movistar Cloud (uniextra WebDAV proxy) as a WebDAV + crypt
# filesystem on /mnt/movistar_proxy.
#
# Chain: movistar_encrypted (rclone crypt remote) -> movistar_proxy remote
#   (uniextra container, http://localhost:5052/) -> Movistar micloud backend.
# Jellyfin consumes /media4 (bind of this mount).
#
# Related units:
#   rclone-cache-clean-proxy.sh (ExecStartPre: wipes VFS cache on every start)
#
# Logs: /var/log/rclone-movistar-proxy.log (DEBUG level).
# ============================================================================
[Unit]
Description=Rclone mount Movistar Proxy (uniextra WebDAV + crypt)
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/root/.config/rclone/rclone.conf
StartLimitIntervalSec=0

[Service]
Type=notify
User=root
Group=root

ExecStartPre=/usr/local/bin/rclone-cache-clean-proxy.sh
ExecStart=/usr/bin/rclone mount movistar_encrypted: /mnt/movistar_proxy \
  --config /root/.config/rclone/rclone.conf \
  --allow-other \
  --allow-non-empty \
  --uid 1000 \
  --gid 1000 \
  --umask 002 \
  --vfs-cache-mode full \
  --vfs-cache-max-size 100G \
  --vfs-write-back 5s \
  --cache-dir=/mnt/movistar_proxy_cache \
  --vfs-read-chunk-size 134217728 \
  --vfs-read-chunk-size-limit 134217728 \
  --buffer-size 16M \
  --vfs-read-wait 20ms \
  --dir-cache-time 5m \
  --attr-timeout 10m \
  --timeout 5m \
  --contimeout 30s \
  --retries 10 \
  --low-level-retries 30 \
  --vfs-cache-max-age 72h \
  --async-read \
  --rc \
  --rc-addr 127.0.0.1:5574 \
  --log-level DEBUG \
  --log-file /var/log/rclone-movistar-proxy.log

ExecStartPost=/bin/bash -c 'for i in $$(seq 1 10); do mountpoint -q /mnt/movistar_proxy && mount --make-shared /mnt/movistar_proxy && break; sleep 1; done'
ExecStop=/bin/fusermount3 -uz /mnt/movistar_proxy
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target